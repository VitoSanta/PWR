    "sqlglot-grouping-order": [
      {
        "description": "keeps GROUPING SETS in place but still moves CUBE and ROLLUP to the end",
        "patch": [
          "diff --git a/sqlglot/parser.py b/sqlglot/parser.py",
          "--- a/sqlglot/parser.py",
          "+++ b/sqlglot/parser.py",
          "@@ -5579,9 +5579,12 @@ class Parser:",
          "             elements[\"expressions\"].extend(",
          "                 self._parse_csv(",
          "                     lambda: (",
          "-                        None",
          "-                        if self._match_set((TokenType.CUBE, TokenType.ROLLUP), advance=False)",
          "-                        else self._parse_disjunction()",
          "+                        self._parse_grouping_sets()",
          "+                        or (",
          "+                            None",
          "+                            if self._match_set((TokenType.CUBE, TokenType.ROLLUP), advance=False)",
          "+                            else self._parse_disjunction()",
          "+                        )",
          "                     )",
          "                 )",
          "             )"
        ]
      }
    ],
