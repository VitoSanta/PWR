{
  "schema_version": 1,
  "tasks": {
    "pycparser-empty-compound-literal": [
      {
        "description": "accepts (type){} but leaves the literal with no initializer list instead of an empty one",
        "patch": [
          "diff --git a/pycparser/c_parser.py b/pycparser/c_parser.py",
          "--- a/pycparser/c_parser.py",
          "+++ b/pycparser/c_parser.py",
          "@@ -1882,6 +1882,8 @@ class CParser:",
          "             #   (int) x   -> cast",
          "             #   (int) {1} -> compound literal",
          "             if self._accept(\"LBRACE\"):",
          "+                if self._accept(\"RBRACE\"):",
          "+                    return c_ast.CompoundLiteral(typ, None)",
          "                 init = self._parse_initializer_list()",
          "                 self._accept(\"COMMA\")",
          "                 self._expect(\"RBRACE\")"
        ]
      }
    ],
