    "bottle-inm-overrides-ims": [
      {
        "description": "checks If-None-Match first but still lets If-Modified-Since answer 304 when the etag did not match",
        "patch": [
          "diff --git a/bottle.py b/bottle.py",
          "--- a/bottle.py",
          "+++ b/bottle.py",
          "@@ -2822,9 +2822,10 @@ def static_file(filename, root,",
          " ",
          "     if etag:",
          "         headers['ETag'] = etag",
          "-        check = getenv('HTTP_IF_NONE_MATCH')",
          "-        if check and check == etag:",
          "-            return HTTPResponse(status=304, **headers)",
          "+",
          "+    inm = getenv('HTTP_IF_NONE_MATCH')",
          "+    if inm and inm == etag:",
          "+        return HTTPResponse(status=304, **headers)",
          " ",
          "     ims = getenv('HTTP_IF_MODIFIED_SINCE')",
          "     if ims:"
        ]
      }
    ],
