    "bottle-json-config": [
      {
        "description": "honours json.enable but ignores json.dump_func",
        "patch": [
          "diff --git a/bottle.py b/bottle.py",
          "--- a/bottle.py",
          "+++ b/bottle.py",
          "@@ -1973,7 +1973,8 @@ class JSONPlugin:",
          " ",
          "     def apply(self, callback, route):",
          "         dumps = self.json_dumps",
          "-        if not self.json_dumps: return callback",
          "+        if not self.json_dumps or route.config['json.enable'] is False:",
          "+            return callback",
          " ",
          "         @functools.wraps(callback)",
          "         def wrapper(*a, **ka):"
        ]
      }
    ],
