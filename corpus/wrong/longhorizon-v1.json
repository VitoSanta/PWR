    "sqlglot-mysql-binary-attribute": [
      {
        "description": "reads the BINARY attribute as CHARACTER SET binary, so it does not round-trip",
        "patch": [
          "diff --git a/sqlglot/parsers/mysql.py b/sqlglot/parsers/mysql.py",
          "--- a/sqlglot/parsers/mysql.py",
          "+++ b/sqlglot/parsers/mysql.py",
          "@@ -239,6 +239,9 @@ class MySQLParser(parser.Parser):",
          " ",
          "     CONSTRAINT_PARSERS = {",
          "         **parser.Parser.CONSTRAINT_PARSERS,",
          "+        \"BINARY\": lambda self: self.expression(",
          "+            exp.CharacterSetColumnConstraint(this=exp.var(\"binary\"))",
          "+        ),",
          "         \"FULLTEXT\": lambda self: self._parse_index_constraint(kind=\"FULLTEXT\"),",
          "         \"INDEX\": lambda self: self._parse_index_constraint(),",
          "         \"KEY\": lambda self: self._parse_index_constraint(),"
        ]
      }
    ],
