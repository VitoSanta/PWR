          "                     \"common-31\",",
          "                     \"common-29\",",
          "                 }:"
        ]
      }
    ],
    "tomli-key-parts-limit": [
      {
        "description": "limits the parts but raises ValueError instead of RecursionError",
        "patch": [
          "diff --git a/src/tomli/_parser.py b/src/tomli/_parser.py",
          "--- a/src/tomli/_parser.py",
          "+++ b/src/tomli/_parser.py",
          "@@ -471,6 +471,8 @@ def parse_key(src: str, pos: Pos) -> tuple[Pos, Key]:",
          "             char = None",
          "         if char != \".\":",
          "             return pos, key",
          "+        if len(key) > sys.getrecursionlimit():",
          "+            raise ValueError(f\"TOML key has more than the allowed {sys.getrecursionlimit()} parts\")",
          "         pos += 1",
          "         pos = skip_chars(src, pos, TOML_WS)",
          "         pos, key_part = parse_key_part(src, pos)"
        ]
      }
    ],
    "idna-incremental-domain-length": [
      {
        "description": "checks the length of each call's output, not of everything emitted so far",
        "patch": [
          "diff --git a/idna/codec.py b/idna/codec.py",
          "--- a/idna/codec.py",
          "+++ b/idna/codec.py",
          "@@ -77,6 +77,8 @@ class IncrementalEncoder(codecs.BufferedIncrementalEncoder):",
          " ",
          "         result_bytes = b\".\".join(result) + trailing_dot",
          "         size += len(trailing_dot)",
          "+        if len(result_bytes) > 254 or (len(result_bytes) == 254 and not result_bytes.endswith(b\".\")):",
          "+            raise IDNAError(\"Domain too long\")",
          "         return result_bytes, size",
          " ",
          " "
        ]
      }
    ],
    "idna-error-attributes": [
      {
        "description": "adds the three attributes to IDNAError but never populates them",
        "patch": [
          "diff --git a/idna/core.py b/idna/core.py",
          "--- a/idna/core.py",
          "+++ b/idna/core.py",
          "@@ -43,6 +43,10 @@ def _joining_type(cp: int) -> str | None:",
          " class IDNAError(UnicodeError):",
          "     \"\"\"Base exception for all IDNA-encoding related problems\"\"\"",
          " ",
          "+    text = None",
          "+    codepoint = None",
          "+    position = None",
          "+",
          " ",
          " class IDNABidiError(IDNAError):",
          "     \"\"\"Exception when bidirectional requirements are not satisfied\"\"\""
        ]
      }
    ]
  }
