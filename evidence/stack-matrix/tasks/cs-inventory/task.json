{
 "id": "cs-inventory",
 "title": "C#: an ASP.NET Core minimal API with validation, conflicts and stats",
 "stacks": ["csharp", "dotnet", "aspnetcore"],
 "category": "backend-api",
 "split": "dev",
 "allow": ["network_access", "dependency_change", "toolchain_install"],
