 "verify": {
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "command": "dotnet test tests/Inventory.Api.Tests 2>&1",
  "restore": ["tests/Inventory.Api.Tests/InventoryApiTests.cs", "tests/Inventory.Api.Tests/Inventory.Api.Tests.csproj"],
  "cache": ["nuget:/root/.nuget/packages"],
  "timeout": 1500,
  "expect": "Passed!|Test summary: total: \\d+, failed: 0"
 }
}
