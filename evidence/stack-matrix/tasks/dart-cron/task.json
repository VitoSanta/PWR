{
 "id": "dart-cron",
 "title": "Dart: cron expressions -- parsing, Vixie day rules, next run across months and leap years -- on a machine without Dart",
 "stacks": ["dart", "pub"],
 "category": "algorithmic-library",
 "split": "heldout",
 "needs": ["dart"],
 "allow": ["network_access", "toolchain_install", "dependency_change", "container_engine"],
 "turns": 3,
 "minutes": 90,
 "verify": {
  "image": "dart:stable",
  "command": "dart pub get >/dev/null && dart test 2>&1",
  "restore": ["test/cron_test.dart", "pubspec.yaml"],
  "cache": ["pub:/root/.pub-cache"],
  "timeout": 900,
  "expect": "All tests passed!"
 }
}
