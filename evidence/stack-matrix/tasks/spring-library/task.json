{
 "id": "spring-library",
 "title": "Spring Boot 3 + JPA + Bean Validation: a lending library API with loan rules and an injected clock",
 "stacks": ["java", "spring-boot", "jpa", "h2", "maven", "junit"],
 "category": "backend-framework",
 "split": "dev",
 "needs": ["jdk", "maven"],
 "allow": ["network_access", "toolchain_install", "dependency_change"],
 "turns": 3,
 "minutes": 90,
 "verify": {
  "image": "maven:3.9-eclipse-temurin-21",
  "command": "mvn -B -q test 2>&1 && echo TESTS-OK",
  "restore": ["src/test/java/com/example/library/LibraryApiTest.java", "pom.xml", "src/main/resources/application.properties", "src/main/java/com/example/library/LibraryApplication.java"],
  "cache": ["m2:/root/.m2"],
  "timeout": 1800,
  "expect": "^TESTS-OK"
 }
}
