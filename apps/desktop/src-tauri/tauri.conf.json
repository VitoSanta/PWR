{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PWR",
  "version": "0.1.0",
  "identifier": "ai.pwr.desktop",
  "build": {
    "frontendDist": "../dist/desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PWR",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1100,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
