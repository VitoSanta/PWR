{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PWR",
  "version": "0.1.0",
  "identifier": "ai.pwr.desktop",
  "build": {
    "frontendDist": "../dist/desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "cargo build --manifest-path ../../Cargo.toml --target-dir ../../target -p pwr-cli && npm run start",
    "beforeBuildCommand": "npm run build && cargo build --manifest-path ../../Cargo.toml --target-dir ../../target --release -p pwr-cli && sh ../../scripts/bundle-uv.sh"
  },
  "app": {
    "windows": [
      {
        "title": "PWR",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../target/release/pwr": "pwr",
      "resources/uv": "uv"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
